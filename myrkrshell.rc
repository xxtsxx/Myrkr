/* myrkrshell.rc - VERSIONINFO for bin\myrkrshell.dll, the drag-drop shell
   extension (compiled by rc.exe in build.cmd, then linked in).  Self-contained:
   numeric FILEOS/FILETYPE values so no SDK headers are required.

   No icon groups here.  The DLL draws no UI of its own - the menu item it adds
   is drawn by Explorer, and the verb icons come from myrkr.exe.

   One BITMAP, though: the image beside that menu item.  MENUITEMINFO.hbmpItem
   takes an HBITMAP and not an HICON, and converting one to the other at runtime
   would mean linking gdi32 into a DLL that lives inside explorer.exe.  So the
   conversion is done at author time by tools\make_menu_bmp.py - which reads
   myrkr.ico, premultiplies the alpha and writes menu16.bmp - and this file just
   embeds the result.  LoadImageW is user32, which is already imported.

   Regenerate menu16.bmp whenever myrkr.ico changes.  build.cmd runs
   make_menu_bmp.py --check and fails a strict build if the two have drifted
   apart, because a generated file committed beside its source is exactly the
   kind that stops matching in silence.  tests\menuicon.ps1 then checks the
   other half - that the bitmap survives rc.exe and LoadImageW as a 32-bit DIB
   with its alpha still premultiplied, which is what a menu needs to draw it
   with transparency at all. */

1 BITMAP "menu16.bmp"

/* This DLL is loaded INTO explorer.exe, so the version block is not decoration:
   it is what an administrator staring at a module list in a crash dump or in
   Autoruns has to identify it by.  The version must match myrkr.exe's -
   tools\constcheck.py compares this file against myrkr.rc and gui.asm, because
   two binaries shipped in one MSI reporting different versions is a support
   call nobody can answer. */

1 VERSIONINFO
 FILEVERSION    1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L            /* VOS_NT_WINDOWS32 */
 FILETYPE       0x2L                /* VFT_DLL */
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"           /* US English (0x0409), Unicode (1200) */
        BEGIN
            VALUE "CompanyName",      "Thomas Smistad"
            VALUE "FileDescription",  "Myrkr drag-drop shell extension"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "myrkrshell"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Thomas Smistad"
            VALUE "OriginalFilename", "myrkrshell.dll"
            VALUE "ProductName",      "Myrkr"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
